@startuml
skinparam linetype ortho
skinparam dpi 400

class Bruger {
  id: Integer
  type: Byte
  navn: String
  email: String
}

class Afgang {
  id: Integer
  udbyder_id: FK
  tidspunkt: Datetime
  udrejse: Byte
  aflyst: Byte
}

class Billet {
  id: Integer
  afgang_id: FK
  kunde_id: FK nullable
  registreringsnummer: String nullable
}

class Tilkøb {
  id: Integer
  navn: String
}

class Billet_Tilkøb {
  billet_id: FK
  tilkøb_id: FK
}

Bruger "1" -- "0..*" Afgang: Udbyder
Afgang "1" -- "1..*" Billet
Bruger "0..1" -- "1..*" Billet: Kunde

Billet "1" -- "0..*" Billet_Tilkøb
Tilkøb "1" -- "0..*" Billet_Tilkøb

@enduml