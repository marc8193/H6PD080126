@startuml
skinparam linetype ortho
skinparam dpi 400

class Bruger {
  id: Integer
  type: Enum
  navn: String
  email: String
}

class Afgang {
  id: Integer
  udbyder_id: FK
  tidspunkt: Datetime
  udrejse: Byte
  aflyst: Byte
}

class Billet {
  id: Integer
  afgang_id: FK
  kunde_id: FK
}

class Tilkøb {
  id: Integer
  navn: String
}

class Billet_Tilkøb {
  billet_id: FK
  tilkøb_id: FK
}

class Køretøj {
  id: Integer
  registreringsnummer: String
}

class Billet_Køretøj {
  billet_id: FK
  køretøj_id: FK
}

Bruger "1" -- "0..*" Afgang
Afgang "1" -- "1..*" Billet
Bruger "1" -- "1..*" Billet

Billet "1" -- "0..*" Billet_Tilkøb
Tilkøb "1" -- "0..*" Billet_Tilkøb

Billet "1" -- "0..*" Billet_Køretøj
Køretøj "1" -- "0..*" Billet_Køretøj

@enduml